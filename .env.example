# Local Qwen OpenAI-compatible Responses endpoint
QWEN_BASE_URL=http://127.0.0.1:8001/v1
QWEN_API_KEY=
QWEN_MODEL=qwen
QWEN_HOURLY_COST_USD=0

# Azure OpenAI Responses endpoint
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2025-04-01-preview
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_JUDGE_DEPLOYMENT=
AZURE_INPUT_COST_PER_MILLION=0
AZURE_OUTPUT_COST_PER_MILLION=0

# Router
ROUTER_DATA_DIR=data
ROUTER_STORE_CONTENT=false
ROUTER_API_KEY=
