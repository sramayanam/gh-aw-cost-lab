# Foundry Local OpenAI-compatible endpoint
QWEN_BASE_URL=http://127.0.0.1:49508/v1
QWEN_API_KEY=
QWEN_MODEL=qwen3.5-4b-generic-gpu
QWEN_HOURLY_COST_USD=0

# Azure OpenAI Chat Completions endpoint
# Leave the key empty to use DefaultAzureCredential (Azure CLI, managed identity).
AZURE_OPENAI_ENDPOINT=https://zavaairaifoundry.openai.azure.com/openai/v1
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4.1-mini
AZURE_OPENAI_JUDGE_DEPLOYMENT=gpt-4.1-mini
AZURE_INPUT_COST_PER_MILLION=0
AZURE_OUTPUT_COST_PER_MILLION=0

# Router
ROUTER_DATA_DIR=data
ROUTER_STORE_CONTENT=false
ROUTER_API_KEY=
ROUTER_REQUEST_TIMEOUT_SECONDS=120
